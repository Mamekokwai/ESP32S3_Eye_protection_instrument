# Apply in addition to sdkconfig.defaults, in a separate production build dir.
#
# Encryption is intentionally disabled for the current hardware test phase.
# Re-enable these options only for a dedicated production build after the
# provisioning procedure has been reviewed; Secure Boot and flash-encryption
# eFuses are one-way and must never be tested on a development board.
CONFIG_EFUSE_CUSTOM_TABLE=y
CONFIG_EFUSE_CUSTOM_TABLE_FILENAME="main/esp_efuse_custom_table.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
# CONFIG_EYECARE_PRODUCTION_LOCK is not set
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_BOOT_V2_ENABLED is not set
# CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME is not set
# CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
# CONFIG_SECURE_FLASH_ENCRYPTION_AES256 is not set
# CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE is not set
# CONFIG_SECURE_ENABLE_SECURE_ROM_DL_MODE is not set
# CONFIG_NVS_ENCRYPTION is not set
# CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC is not set
